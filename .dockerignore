# -----------------------------
# Git
# -----------------------------
# Ignore git repository data
.git
.gitignore

# -----------------------------
# Python cache files
# -----------------------------
# Compiled python files and cache directories
__pycache__/
*.pyc
*.pyo
*.pyd

# -----------------------------
# Virtual environments
# -----------------------------
# Local virtual environments should not be copied to the container
.venv/
venv/
env/

# -----------------------------
# Build artifacts
# -----------------------------
# Python packaging outputs
build/
dist/
*.egg-info/

# -----------------------------
# Logs
# -----------------------------
# Application logs
*.log
logs/

# -----------------------------
# Test files
# -----------------------------
# Tests are usually not needed in production images
tests/
.pytest_cache/

# -----------------------------
# IDE / Editor folders
# -----------------------------
# Local development environment files
.vscode/
.idea/

# -----------------------------
# OS generated files
# -----------------------------
# System files generated by macOS / Windows
.DS_Store
Thumbs.db

# -----------------------------
# Environment variables / secrets
# -----------------------------
# Do not include environment files in the image
.env
.env.*

# -----------------------------
# Docker development files
# -----------------------------
# Usually not needed inside the container image
docker-compose.yml